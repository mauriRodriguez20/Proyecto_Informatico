generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["interactions"]
}

enum CommentTargetType {
  PUBLICATION
  QUESTION

  @@schema("interactions")
}

enum RatingTargetType {
  PUBLICATION
  ANSWER

  @@schema("interactions")
}

model Comment {
  id          String   @id @default(uuid())
  authorId    String
  targetType  CommentTargetType
  targetId    String
  content     String   @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([authorId])
  @@map("comments")
  @@schema("interactions")
}

model Rating {
  id             String           @id @default(uuid())
  raterId        String
  targetAuthorId String
  targetType     RatingTargetType
  targetId       String
  score          Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([raterId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([targetAuthorId])
  @@index([score])
  @@map("ratings")
  @@schema("interactions")
}

model UserReputation {
  userId       String   @id
  avgRating    Float    @default(0)
  totalRatings Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([avgRating])
  @@map("user_reputations")
  @@schema("interactions")
}

model UserStats {
  userId             String   @id
  publicationsCount  Int      @default(0)
  questionsCount     Int      @default(0)
  answersCount       Int      @default(0)
  avgRating          Float    @default(0)
  totalRatings       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([avgRating])
  @@map("user_stats")
  @@schema("interactions")
}
