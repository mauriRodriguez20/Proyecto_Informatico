                         "clsx":  "^2.1.1",
                         "framer-motion":  "^12.35.1",
                         "lucide-react":  "^0.577.0",
                         "next":  "^16.1.6",
                         "prisma":  "^5.22.0",
                         "react":  "^18",
                         "react-dom":  "^18",
                         "tailwind-merge":  "^3.5.0",
                         "zod":  "^3.22.4"
                     },
    "devDependencies":  {
                            "@vitest/coverage-v8":  "^3.2.4",
                            "@types/node":  "^20.19.39",
